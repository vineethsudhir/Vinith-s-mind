---
interface Item {
  when: string;
  title: string;
  detail?: string;
  now?: boolean;
}
interface Props {
  items: Item[];
  label: string;
}
const { items, label } = Astro.props;
---

<section class="guide-band" aria-label={label}>
  <div class="wrap">
    <ol class="guide">
      {
        items.map((item) => (
          <li class:list={['slot', { 'slot--now': item.now }]}>
            <span class="when">
              {item.now && <span class="live" aria-hidden="true" />}
              {item.when}
            </span>
            <span class="what">
              <strong>{item.title}</strong>
              {item.detail && <span class="detail">{item.detail}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* The programme guide: one row per slot, like a live TV schedule. */
  .guide-band {
    background: var(--band);
    border-block: 1px solid var(--rule);
  }

  .guide {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--sans);
  }

  .slot {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }

  .slot:first-child {
    border-top: 0;
  }

  .when {
    color: var(--mist);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
    display: flex;
    align-items: center;
    align-self: start;
    gap: 0.5rem;
  }

  .what strong {
    display: block;
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .detail {
    display: block;
    color: var(--mist);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .slot--now {
    padding-block: 1.5rem;
  }

  .slot--now .when {
    color: var(--cherry);
    font-weight: 700;
  }

  .slot--now strong {
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }

  .live {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--cherry);
    flex: none;
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 34rem) {
    .slot {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
